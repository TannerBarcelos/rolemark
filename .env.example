# Local development only. `bun run dev` runs the app in workerd and loads these as Worker
# secrets; drizzle-kit reads DATABASE_URL. Production values: `wrangler secret put <NAME>`.

# Used by drizzle-kit (migrations). The Worker connects via the HYPERDRIVE binding instead,
# whose local connection string lives in wrangler.jsonc.
DATABASE_URL=postgres://rolemark:rolemark@localhost:5432/rolemark

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
