# Postgres connection string (docker compose up -d starts one matching this)
DATABASE_URL=postgres://rolemark:rolemark@localhost:5432/rolemark

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
