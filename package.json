    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "auth": "^1.7.5",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.2",
