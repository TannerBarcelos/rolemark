{
  "name": "rolemark",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "auth:generate": "auth generate --config src/auth/auth.cli.ts --output src/db/schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:diff": "bun scripts/diff-coverage.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.114",
    "@cloudflare/ai-chat": "^0.12.0",
    "@sentry/cloudflare": "^10.75.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "agents": "^0.24.0",
    "ai": "^7.0.111",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.1.0",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "auth": "^1.7.5",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.136.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
