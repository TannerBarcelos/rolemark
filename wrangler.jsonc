{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rolemark",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  // Workers AI. Always remote, so `bun run dev` needs `wrangler login`; tests fake it
  // (docs/integrations.md#ai-features).
  "ai": { "binding": "AI" },
  "hyperdrive": [
    {
      // Points at the PlanetScale Postgres `main` branch through its `app` role (DML only, direct
      // port 5432; Hyperdrive does the pooling). Create with caching disabled; the default cache
      // serves stale read-after-write (docs/known-concerns.md):
      //   wrangler hyperdrive create rolemark-db --caching-disabled \
      //     --connection-string="postgresql://app.<branch-id>:<password>@<host>:5432/postgres"
      // Full steps: docs/planetscale.md.
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      // Used by `bun run dev` instead of the real Hyperdrive (matches docker-compose.yml).
      "localConnectionString": "postgres://rolemark:rolemark@localhost:5432/rolemark",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://rolemark.example.com",
    // Default chat model (docs/integrations.md#ai-features). Changing models is a config change.
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    // AI Gateway id for logs, caching, and rate limits. Empty calls Workers AI directly.
    "AI_GATEWAY_ID": "",
  },
  // Secrets (wrangler secret put <NAME>): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET

  // Top level = production (deployed from main). Staging is deployed from develop and must never
  // share production's database: bindings and vars are not inherited, so each is set here. The
  // environment is chosen at build time: `CLOUDFLARE_ENV=staging bun run build`.
  "env": {
    "staging": {
      "name": "rolemark-staging",
      "ai": { "binding": "AI" },
      "hyperdrive": [
        {
          // PlanetScale `staging` branch, its own `app` role. Same flags as production:
          //   wrangler hyperdrive create rolemark-db-staging --caching-disabled \
          //     --connection-string="postgresql://app.<staging-branch-id>:<password>@<host>:5432/postgres"
          "binding": "HYPERDRIVE",
          "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID",
          "localConnectionString": "postgres://rolemark:rolemark@localhost:5432/rolemark",
        },
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://staging.rolemark.example.com",
        "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
        "AI_GATEWAY_ID": "",
      },
      // Secrets (wrangler secret put <NAME> --env staging): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
      // GOOGLE_CLIENT_SECRET. Use a different BETTER_AUTH_SECRET from production.
    },
  },
}
